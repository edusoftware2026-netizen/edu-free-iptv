# Copia este archivo como "keystore.properties" en esta misma carpeta (android/)
# y completa con los datos reales de tu keystore de Play Store.
# NUNCA subas keystore.properties ni tu .keystore/.jks a Git.
storeFile=edu-iptv-release.keystore
storePassword=TU_PASSWORD_KEYSTORE
keyAlias=eduiptv
keyPassword=TU_PASSWORD_ALIAS
